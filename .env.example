# ---- Storage backend (Ceph RGW / any S3-compatible service) ----

# RGW endpoint the app AND browsers reach. Presigned upload URLs point here,
# so it must be resolvable from user machines, not only from the container.
S3_ENDPOINT=https://s3.internal.example.com

# Any region string accepted by your RGW ("default" is common for Ceph).
S3_REGION=default

# Credentials — keep server-side only.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

S3_BUCKET=files

# Ceph RGW almost always needs path-style addressing (bucket in the path,
# not the hostname). Keep true unless your gateway uses virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# ---- Public URL ----

# Base URL users type into their browser. Used to build stable direct
# download links (/files/<key>). Must match how the app is reached through
# ingress/proxies. When unset, the request's own host is used instead.
APP_BASE_URL=https://files.internal.example.com

# ---- Tuning (optional) ----

# Multipart part size in MiB (8..5120). 64 MiB -> ~160 parts per 10 GB file.
UPLOAD_PART_SIZE_MB=64

# Presigned URL lifetime in seconds (60..604800).
PRESIGN_EXPIRY_SECONDS=86400

# debug | info | warn | error
LOG_LEVEL=info
